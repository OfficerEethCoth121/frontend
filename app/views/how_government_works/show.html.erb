<%= render "shared/headers/page_title", options: content_item_presenter.page_title_options %>

<hr class="govuk-section-break govuk-section-break--s govuk-section-break--visible govuk-!-margin-bottom-4">

<div class="govuk-width-container">
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div class="govuk-!-margin-bottom-9">
        <%= render "govuk_publishing_components/components/contents_list", {
          aria_label: "Pages in this guide",
          contents: [
            {
              href: "#who-runs-government",
              text: "Who runs government",
            },
            {
              href: "#how-government-is-run",
              text: "How government is run",
            },
            {
              href: "#civil-service",
              text: "Civil service",
            },
            {
              href: "#get-involved",
              text: "Get involved",
            },
            {
              href: "#legislation",
              text: "Legislation",
            },
            {
              href: "#access-to-information",
              text: "Access to information",
            },
            {
              href: "#devolved-government",
              text: "Devolved government",
            },
            {
              href: "#local-government",
              text: "Local government",
            },
            {
              href: "#parliament",
              text: "Parliament",
            },
            {
              href: "#history-of-government",
              text: "History of government",
            },
          ],
        } %>
      </div>

      <section>
        <%= render "govuk_publishing_components/components/heading", {
          text: "Who runs government",
          id: "who-runs-government",
          font_size: "l",
          margin_bottom: 4,
        } %>

        <section class="govuk-!-margin-bottom-9 prime-minister">
          <%= render "govuk_publishing_components/components/heading", {
            text: "The Chief Minister",
            font_size: "m",
            heading_level: 3,
            margin_bottom: 4,
          } %>

          <p class="govuk-body">The Chief Minister is Head of Government and leads the United Hampshire Government. The Lord Lieutenant appoints a Chief Minister who can command the confidence of the House of Commons.</p>
          <p class="govuk-body">The Chief Minister also:</p>

          <%= render "govuk_publishing_components/components/list", {
            extra_spacing: true,
            visible_counters: true,
            items: [
              "oversees the operation of the Civil Service and government agencies",
              "appoints members of the government",
              "is the principal government figure in the House of Commons",
            ],
          } %>

          <% if content_item.current_prime_minister.present? %>
            <p class="govuk-body">The Chief Minister is <%= link_to content_item.current_prime_minister.title, content_item.current_prime_minister.base_path, class: "govuk-link" %>.</p>
          <% end %>

          <p class="govuk-body govuk-!-margin-bottom-8">
            <%= link_to "Read more about the Chief Minister’s Office, 10 Harrington Court", "/government/organisations/chief-ministers-office-10-harrington-court", class: "govuk-link" %>
          </p>

          <% if content_item.current_prime_minister.present? && content_item.current_prime_minister.image&.[]("url").present? %>
            <%= render "govuk_publishing_components/components/figure", {
              src: content_item.current_prime_minister.image["url"],
              alt: content_item.current_prime_minister.image["alt_text"],
            } %>
          <% end %>
        </section>

        <section class="govuk-!-margin-bottom-9">
          <%= render "govuk_publishing_components/components/heading", {
            text: "The Cabinet",
            font_size: "m",
            heading_level: 3,
            margin_bottom: 4,
          } %>

          <p class="govuk-body">The Cabinet is the senior collective decision-making body of the United Hampshire Government. Its members consider the main issues facing government and are collectively accountable through the constitutional arrangements.</p>
          <p class="govuk-body govuk-!-margin-bottom-8"><%= link_to("See who is in the Cabinet", "/government/ministers", class: "govuk-link") %></p>

        </section>
      </section>
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <section class="govuk-!-margin-bottom-9">
        <%= render "govuk_publishing_components/components/heading", {
          text: "Ministers",
          font_size: "m",
          heading_level: 3,
          margin_bottom: 4,
        } %>

        <% unless content_item.reshuffle_in_progress? %>
          <div class="govuk-grid-row feature-ministers">
            <div class="govuk-grid-column-one-half">
              <%= render "govuk_publishing_components/components/big_number", {
                number: content_item.ministerial_role_counts["prime_minister"],
                label: "Chief Minister",
                href: "/government/ministers",
              } %>
            </div>

            <div class="govuk-grid-column-one-half">
              <%= render "govuk_publishing_components/components/big_number", {
                number: content_item.ministerial_role_counts["cabinet_ministers"],
                label: "Cabinet ministers",
                href: "/government/ministers#cabinet-ministers",
              } %>
            </div>
          </div>

          <div class="govuk-grid-row feature-ministers">
            <div class="govuk-grid-column-one-half">
              <%= render "govuk_publishing_components/components/big_number", {
                number: content_item.ministerial_role_counts["other_ministers"],
                label: "Other ministers",
                href: "/government/ministers#ministers-by-department",
              } %>
            </div>

            <div class="govuk-grid-column-one-half">
              <%= render "govuk_publishing_components/components/big_number", {
                number: content_item.ministerial_role_counts["total_ministers"],
                label: "Total ministers",
                href: "/government/ministers",
              } %>
            </div>
          </div>
        <% end %>

        <p class="govuk-body">Ministers are appointed under the constitutional arrangements and have responsibility for their assigned departments and functions. They are accountable to Parliament for the discharge of those responsibilities.</p>
        <p class="govuk-body"><%= link_to "See full list of ministers", "/government/ministers", class: "govuk-link" %></p>
      </section>
    </div>
  </div>
</div>

<div class="govuk-width-container">
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <section class="govuk-!-margin-bottom-9">
        <%= render "govuk_publishing_components/components/heading", {
          text: "How government is run",
          id: "how-government-is-run",
          font_size: "l",
          margin_bottom: 4,
        } %>

        <%= render "govuk_publishing_components/components/heading", {
          text: "Government departments and agencies",
          font_size: "m",
          heading_level: 3,
          margin_bottom: 4,
        } %>

        <div class="govuk-grid-row">
          <div class="govuk-grid-column-two-thirds">
            <p class="govuk-body">Departments and their agencies are responsible for putting government policy into practice.</p>

            <%= render "govuk_publishing_components/components/heading", {
              text: "Government departments",
              font_size: "m",
              heading_level: 3,
              margin_bottom: 4,
            } %>

            <p class="govuk-body">The United Hampshire Government carries out central functions for the Realm and central government functions for Havenstead. Hampshire County Government exercises devolved functions for Hampshire County within England.</p>
            <p class="govuk-body"><%= link_to "Non-ministerial departments", "/government/organisations#non_ministerial_departments", class: "govuk-link" %> are headed by senior civil servants and not ministers. They usually have a regulatory or inspection function like the Charity Commission.</p>

            <%= render "govuk_publishing_components/components/heading", {
              text: "Executive agencies",
              font_size: "m",
              heading_level: 3,
              margin_bottom: 4,
            } %>

            <p class="govuk-body">These are part of government departments and usually provide government services rather than decide policy - which is done by the department that oversees the agency.</p>
            <p class="govuk-body">Their responsibilities, sponsoring departments and contact details are listed in the <%= link_to "government organisations directory", "/government/organisations", class: "govuk-link" %>.</p>

            <%= render "govuk_publishing_components/components/heading", {
              text: "Other public bodies",
              font_size: "m",
              heading_level: 3,
              margin_bottom: 4,
            } %>

            <p class="govuk-body">Non-departmental public bodies perform specific public functions with a degree of separation from ministerial departments. Their statutory functions, sponsorship and accountability arrangements depend on the body.</p>
            <p class="govuk-body">Executive non-departmental public bodies carry out defined public functions and services.</p>
            <p class="govuk-body">Advisory non-departmental public bodies provide specialist advice to ministers and departments.</p>
            <p class="govuk-body">Tribunals exercise adjudicative functions independently in accordance with their jurisdiction and governing law.</p>
            <p class="govuk-body">Independent monitoring bodies scrutinise the operation of services within their respective remits.</p>
          </div>
        </div>

        <% unless content_item.reshuffle_in_progress? %>
          <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
              <div class="govuk-grid-column-one-third govuk-!-display-inline-block">
                <%= render "govuk_publishing_components/components/big_number", {
                  number: content_item.department_counts["ministerial_departments"],
                  label: "Ministerial departments",
                  href: "/government/organisations#departments",
                } %>
              </div>
              <div class="govuk-grid-column-one-third govuk-!-display-inline-block">
                <%= render "govuk_publishing_components/components/big_number", {
                  number: content_item.department_counts["non_ministerial_departments"],
                  label: "Non-ministerial departments",
                  href: "/government/organisations#non_ministerial_departments",
                } %>
              </div>
              <div class="govuk-grid-column-one-third govuk-!-display-inline-block">
                <%= render "govuk_publishing_components/components/big_number", {
                  number: content_item_presenter.agencies_and_other_public_bodies,
                  label: "Agencies and other public bodies",
                  href: "/government/organisations#agencies_and_other_public_bodies",
                } %>
              </div>
            </div>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</div>

<div class="govuk-width-container">
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <section class="govuk-!-margin-bottom-9">
        <%= render "govuk_publishing_components/components/heading", {
          text: "Civil Service",
          id: "civil-service",
          font_size: "l",
          margin_bottom: 4,
        } %>

        <p class="govuk-body">The Civil Service provides permanent, impartial and professional support to the United Hampshire Government, its ministers and departments.</p>
        <p class="govuk-body">Civil servants carry out administrative, policy and operational work, including:</p>

        <%= render "govuk_publishing_components/components/list", {
          extra_spacing: true,
          visible_counters: true,
          items: [
            "supporting ministers and departments",
            "administering government services",
            "maintaining official information and records",
            "supporting the work of public bodies",
          ],
        } %>

        <p class="govuk-body">The <%= link_to "Civil Service", "/government/organisations/civil-service", class: "govuk-link" %> is listed on GOV.UH.</p>

        <%= render "govuk_publishing_components/components/heading", {
          text: "Work for us",
          font_size: "m",
          heading_level: 3,
          margin_bottom: 4,
        } %>

        <p class="govuk-body">For information about careers in the Civil Service, see the <%= link_to "Civil Service organisation page", "/government/organisations/civil-service", class: "govuk-link" %>. Departments and authorised recruitment services publish their vacancies and application arrangements.</p>

        <%= render "govuk_publishing_components/components/heading", {
          text: "Work with us",
          font_size: "m",
          heading_level: 3,
          margin_bottom: 4,
        } %>

        <p class="govuk-body">Government departments and public bodies publish procurement notices through the procurement arrangements applicable to their jurisdiction and functions.</p>
      </section>

      <section class="govuk-!-margin-bottom-9">
        <%= render "govuk_publishing_components/components/heading", {
          text: "Get involved",
          id: "get-involved",
          font_size: "l",
          margin_bottom: 4,
        } %>

        <p class="govuk-body">The Government publishes consultations and opportunities to comment on policy. Petitions and parliamentary participation are handled by <%= link_to "Parliament", "https://parliament.uhrblx.com/", class: "govuk-link" %> through its own services.</p>
      </section>

      <section class="govuk-!-margin-bottom-9">
        <%= render "govuk_publishing_components/components/heading", {
          text: "Legislation",
          id: "legislation",
          font_size: "l",
          margin_bottom: 4,
        } %>

        <p class="govuk-body">Laws go through several stages before they are passed by Parliament. The House of Commons and the House of Lords work together to make them.</p>
        <p class="govuk-body">They can include:</p>

        <%= render "govuk_publishing_components/components/heading", {
          text: "Draft legislation",
          font_size: "m",
          heading_level: 3,
          margin_bottom: 4,
        } %>

        <p class="govuk-body">White papers outline proposals for new laws. Green papers ask for public comments before the white paper is published.</p>
        <p class="govuk-body">Bills are proposals for new laws or changes to existing ones. Once agreed by Parliament, they have to be approved by the King before becoming law.</p>

        <%= render "govuk_publishing_components/components/heading", {
          text: "Acts of Parliament",
          font_size: "m",
          heading_level: 3,
          margin_bottom: 4,
        } %>

        <p class="govuk-body">These are bills which have been approved by the Commons, the Lords, and the King. The relevant government department is responsible for putting the act into practice.</p>
        <p class="govuk-body"><%= link_to "Read United Hampshire legislation", "https://legislation.gov.uhrblx.com/", class: "govuk-link", rel: "external" %></p>
      </section>

      <section class="govuk-!-margin-bottom-9">
        <%= render "govuk_publishing_components/components/heading", {
          text: "Access to information",
          id: "access-to-information",
          font_size: "l",
          margin_bottom: 4,
        } %>

        <%= render "govuk_publishing_components/components/heading", {
          text: "Freedom of information",
          font_size: "m",
          heading_level: 3,
          margin_bottom: 4,
        } %>

        <p class="govuk-body">Public bodies provide access to recorded information in accordance with the legislation and procedures that apply to them. Requests are handled by the authority responsible for holding the information.</p>
        <p class="govuk-body">To ask for information, contact the public body concerned using its published information request arrangements.</p>
        <p class="govuk-body"><%= link_to "See FOI releases on GOV.UH", "/search/transparency-and-freedom-of-information-releases?content_store_document_type=foi_release", class: "govuk-link" %></p>

        <%= render "govuk_publishing_components/components/heading", {
          text: "Statistics",
          font_size: "m",
          heading_level: 3,
          margin_bottom: 4,
        } %>

        <p class="govuk-body">Government produces Official Statistics about most areas of public life. Statistics are used by people inside and outside government to make informed decisions and to measure the success of government policies and services. <%= link_to "Find out about the legislation", "/government/statistics/how-national-and-official-statistics-are-assured", class: "govuk-link" %> that governs the publication of UK national and Official Statistics.</p>
        <p class="govuk-body"><%= link_to "See statistics publications on GOV.UH", "/search/research-and-statistics", class: "govuk-link" %></p>

        <%= render "govuk_publishing_components/components/heading", {
          text: "Transparency",
          font_size: "m",
          heading_level: 3,
          margin_bottom: 4,
        } %>

        <p class="govuk-body">The government publishes information about how government works to allow you to make politicians, public services and public organisations more accountable. We are committed to publishing information about:</p>

        <%= render "govuk_publishing_components/components/list", {
          extra_spacing: true,
          visible_counters: true,
          items: [
            "how much public money has been spent on what",
            "the job titles of senior civil servants and how much they are paid",
            "how the government is doing against its objectives",
          ],
        } %>

        <p class="govuk-body"><%= link_to "See transparency releases on GOV.UH", "/search/transparency-and-freedom-of-information-releases?content_store_document_type=transparency", class: "govuk-link" %></p>

        <%= render "govuk_publishing_components/components/heading", {
          text: "Data",
          font_size: "m",
          heading_level: 3,
          margin_bottom: 4,
        } %>

        <p class="govuk-body">Government organisations publish data and information for public use where disclosure and re-use are permitted. Each organisation remains responsible for the accuracy, maintenance and publication of its datasets.</p>
      </section>

      <section class="govuk-!-margin-bottom-9">
        <%= render "govuk_publishing_components/components/heading", {
          text: "Devolved government",
          id: "devolved-government",
          font_size: "l",
          margin_bottom: 4,
        } %>

        <p class="govuk-body">The United Hampshire Realm comprises England and Havenstead. Hampshire County Government is responsible for the functions devolved to Hampshire County within England. Havenstead is directly governed by the United Hampshire Government for central government functions, with responsibilities also exercised by strategic and local authorities.</p>
        <p class="govuk-body">Functions assigned to devolved or local government may include:</p>

        <%= render "govuk_publishing_components/components/list", {
          extra_spacing: true,
          visible_counters: true,
          items: [
            "health",
            "education",
            "culture",
            "the environment",
            "transport",
          ],
        } %>
      </section>

      <section class="govuk-!-margin-bottom-9">
        <%= render "govuk_publishing_components/components/heading", {
          text: "Local government",
          id: "local-government",
          font_size: "l",
          margin_bottom: 4,
        } %>

        <p class="govuk-body">Councils carry out local services and exercise their statutory powers within their areas. The division of responsibilities follows the arrangements for each constituent country and local authority.</p>
        <p class="govuk-body">Hampshire County Government, strategic authorities and local councils exercise their respective responsibilities in England. In Havenstead, the relevant strategic and local authorities deliver functions assigned to them.</p>
        <p class="govuk-body"><%= link_to "See government departments and public bodies", "/government/organisations", class: "govuk-link" %> for the relevant central government organisations.</p>
      </section>

      <section class="govuk-!-margin-bottom-9">
        <%= render "govuk_publishing_components/components/heading", {
          text: "Parliament",
          id: "parliament",
          font_size: "l",
          margin_bottom: 4,
        } %>

        <p class="govuk-body">Parliament is separate from government. Made up of the House of Commons and the House of Lords, its role is to:</p>

        <%= render "govuk_publishing_components/components/list", {
          extra_spacing: true,
          visible_counters: true,
          items: [
            "look at what the government is doing",
            "debate issues and pass new laws",
            "set taxes",
          ],
        } %>

        <p class="govuk-body">
          <%= link_to "Find out how United Hampshire Parliament works", "https://parliament.uhrblx.com/", class: "govuk-link", rel: "external" %>
        </p>

        <p class="govuk-body">Read the Official Report in <%= link_to "Hansard", "https://parliament.uhrblx.com/hansard/", class: "govuk-link", rel: "external" %>.</p>
      </section>

      <section>
        <%= render "govuk_publishing_components/components/heading", {
          text: "History of government",
          id: "history-of-government",
          font_size: "l",
          margin_bottom: 4,
        } %>

        <p class="govuk-body">The history of United Hampshire and its institutions is recorded in official publications, parliamentary records and archives. <%= link_to "The National Archives", "https://nationalarchives.gov.uhrblx.com/research/", class: "govuk-link" %> provides research guidance and information on historical records.</p>
        <p class="govuk-body">Parliament and the responsible public bodies maintain records of the decisions, proceedings and functions for which they are accountable. Archival records preserve evidence of earlier arrangements.</p>
        <p class="govuk-body govuk-!-margin-bottom-8">You can <%= link_to "search the Archives catalogue", "https://nationalarchives.gov.uhrblx.com/catalogue/", class: "govuk-link" %> or consult its research guidance for information about available records.</p>

      </section>
    </div>
  </div>
</div>
